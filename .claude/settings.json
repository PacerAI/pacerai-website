{
  "permissions": {
    "allow": [
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run preview*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(ls*)",
      "mcp__wordpress__list_posts",
      "mcp__wordpress__get_post",
      "mcp__wordpress__list_pages",
      "mcp__wordpress__list_categories"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-publish-check.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
