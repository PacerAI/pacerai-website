r:var(--muted);margin-top:8px}\n#pacerai-homepage .note{font-size:13.5px;color:var(--muted);border-top:1px dashed var(--line);margin-top:36px;padding-top:18px}\n#pacerai-homepage .note b{color:var(--ink)}\n\n#pacerai-homepage footer{border-top:1px solid var(--line);background:var(--surface);padding:64px 24px 32px}\n#pacerai-homepage .footer-top{display:grid;grid-template-columns:260px repeat(4,1fr);gap:40px;max-width:var(--maxw);margin:0 auto;padding-bottom:40px;border-bottom:1px solid var(--line)}\n#pacerai-homepage .footer-brand p{font-size:13px;color:var(--muted);line-height:1.7;margin-top:14px}\n#pacerai-homepage .footer-col-head{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mid);margin-bottom:18px}\n#pacerai-homepage .footer-col ul{list-style:none}\n#pacerai-homepage .footer-col li{margin-bottom:10px}\n#pacerai-homepage .footer-col a{font-size:13px;color:var(--muted)}\n#pacerai-homepage .footer-col a:hover{color:var(--teal)}\n\n@media(max-width:900px){\n  #pacerai-homepage nav{grid-template-columns:1fr auto;padding:0 16px}\n  #pacerai-homepage .nav-links{display:none}\n  #pacerai-homepage nav.nav-open .nav-links{display:flex;flex-direction:column;position:fixed;top:64px;left:0;right:0;background:var(--bone);border-bottom:1px solid var(--line);box-shadow:0 14px 34px rgba(15,25,45,.10);padding:10px 16px 16px;gap:0;z-index:130}\n  #pacerai-homepage nav.nav-open .nav-links li{width:100%}\n  #pacerai-homepage nav.nav-open .nav-links a{display:block;width:100%;padding:14px 6px;font-size:16px;border-bottom:1px solid var(--line);border-radius:0}\n  #pacerai-homepage nav.nav-open .mobile-menu-btn span:nth-child(1){transform:translateY(7px) rotate(45deg)}\n  #pacerai-homepage nav.nav-open .mobile-menu-btn span:nth-child(2){opacity:0}\n  #pacerai-homepage nav.nav-open .mobile-menu-btn span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}\n  #pacerai-homepage .mobile-menu-btn span{transition:transform .2s,opacity .2s}\n  #pacerai-homepage .mobile-menu-btn{display:flex}\n  #pacerai-homepage .btn-login{display:none}\n  #pacerai-homepage .hero{padding-top:104px}\n  #pacerai-homepage .hero h1{font-size:29px;line-height:1.2}\n  #pacerai-homepage .hero-sub{font-size:16px}\n  #pacerai-homepage .reel iframe{height:520px}\n  #pacerai-homepage .footer-top{grid-template-columns:1fr 1fr;gap:28px}\n  #pacerai-homepage .footer-brand{grid-column:1/-1}\n}\n</style>\n\n<div id=\"pacerai-homepage\">\n<nav>\n  <a href=\"/\" class=\"nav-logo\">Pacer <span>AI</span>\n    <svg class=\"chev\" viewBox=\"0 0 40 18\" aria-hidden=\"true\"><path d=\"M3 3 L10 9 L3 15\"/><path d=\"M15 3 L22 9 L15 15\"/><path d=\"M27 3 L34 9 L27 15\"/></svg>\n  </a>\n  <ul class=\"nav-links\">\n    <li><a href=\"/#revenue-modeling-agent\">Revenue Modeling Agent</a></li>\n    <li><a href=\"/#use-cases\">Use Cases</a></li>\n    <li><a href=\"/#team\">Team</a></li>\n    <li><a href=\"/#pricing\">Pricing</a></li>\n    <li><a href=\"/resources/\">Resources</a></li>\n  </ul>\n  <div class=\"nav-right\">\n    <a href=\"https://app.getpacerai.com/.auth/login/aad\" class=\"btn-login\">Log In</a>\n    <a href=\"https://calendly.com/pacerai/diagnostic\" class=\"btn-cta\">Free Diagnostic</a>\n    <button class=\"mobile-menu-btn\" aria-label=\"Menu\" onclick=\"this.closest('nav').classList.toggle('nav-open')\"><span></span><span></span><span></span></button>\n  </div>\n</nav>\n\n<section class=\"hero\">\n  <div class=\"kick\">Pacer AI Demo</div>\n  <h1>See if you&rsquo;re on pace &mdash; in Claude, in 2 minutes</h1>\n  <p class=\"hero-sub\">Connect the Pacer AI Demo to Claude, then just type <b>pace</b> and <b>gap</b>. It reads a live book and tells you whether you&rsquo;ll make the number &mdash; and how to close the gap.</p>\n</section>\n\n<div class=\"signup-wrap\">\n  <div class=\"signup\">\n    <iframe src=\"https://pacer-demo-worker.will-078.workers.dev/signup\" title=\"Get demo access \u2014 enter your email\" loading=\"lazy\"></iframe>\n  </div>\n</div>\n\n<div class=\"reel-wrap\">\n  <div class=\"reel\">\n    <iframe src=\"https://pacer-demo-worker-staging.will-078.workers.dev/v/demo-connect\" title=\"Pacer AI \u2014 add the connector, sign in, type pace\" loading=\"lazy\"></iframe>\n  </div>\n  <div class=\"reel-cap\">A guided walkthrough: add the connector, sign in, type <b>pace</b> &mdash; charts render right in the chat. Run it yourself on a synthetic $100M book with the steps below.</div>\n</div>\n\n<div class=\"body\">\n\n  <h2 class=\"sec\">Add the connector <span class=\"pill\">2 min</span></h2>\n  <ol>\n    <li><b>Browser (recommended):</b> open <a class=\"url\" href=\"https://claude.ai/new?modal=add-custom-connector#customize/connectors\">claude.ai/new?modal=add-custom-connector</a> &mdash; it opens the Add-custom-connector dialog directly.</li>\n    <li><b>Mobile or Desktop app:</b> tap the <b>+</b> in the prompt area &rarr; <b>Connectors</b> &rarr; <b>Manage connectors</b> &rarr; <b>Add custom connector</b>.</li>\n    <li>Enter the name <b>Pacer AI Demo</b> and this URL: <span class=\"url\"><a href=\"https://pacerai-demo-mcp.azurewebsites.net/mcp\" rel=\"nofollow\">https://pacerai-demo-mcp.azurewebsites.net/mcp</a></span></li>\n    <li>Keep the detected defaults (<b>Sign in now</b> + <b>Register automatically</b>) and click <b>Add</b>.</li>\n    <li>On the <b>Pacer AI Demo</b> sign-in page, enter your work email + the access password <b>your Pacer contact shared with you</b>.</li>\n  </ol>\n\n  <h2 class=\"sec\">Then just type</h2>\n  <div class=\"prompts\">\n    <div class=\"p\">pace</div>\n    <div class=\"p\">gap</div>\n    <div class=\"p\">how do I close the gap to target?</div>\n  </div>\n  <div class=\"after\">Charts render right in the chat on Claude web/desktop. Follow up in plain English &mdash; ask about a segment, an account, or the month.</div>\n\n  <div class=\"note\">\n    The demo runs on a synthetic $100M book (fictional accounts). Questions? <b>will@getpacerai.com</b>.\n    The access password is never shown here &mdash; it&rsquo;s shared privately in your invitation.\n  </div>\n\n</div>\n\n<footer>\n  <div class=\"footer-top\">\n    <div class=\"footer-brand\">\n      <a href=\"/\" class=\"nav-logo\" style=\"font-size:17px\">Pacer <span style=\"color:var(--teal)\">AI</span>\n        <svg class=\"chev\" viewBox=\"0 0 40 18\" aria-hidden=\"true\"><path d=\"M3 3 L10 9 L3 15\"/><path d=\"M15 3 L22 9 L15 15\"/><path d=\"M27 3 L34 9 L27 15\"/></svg>\n      </a>\n      <p>The Revenue Modeling Agent for Sales Leaders. Reconciled to Finance, built on Microsoft Fabric.</p>\n    </div>\n    <div class=\"footer-col\">\n      <div class=\"footer-col-head\">Product</div>\n      <ul>\n        <li><a href=\"/#revenue-modeling-agent\">Revenue Modeling Agent</a></li>\n        <li><a href=\"/#how-it-works\">How It Works</a></li>\n        <li><a href=\"/#integrations\">Integrations</a></li>\n        <li><a href=\"/#security\">Security</a></li>\n      </ul>\n    </div>\n    <div class=\"footer-col\">\n      <div class=\"footer-col-head\">Use Cases</div>\n      <ul>\n        <li><a href=\"/#gtm-planning\">GTM Planning</a></li>\n        <li><a href=\"/#arr-waterfall-modeling\">ARR Waterfall Modeling</a></li>\n        <li><a href=\"/#case-studies\">Case Studies</a></li>\n        <li><a href=\"/#pricing\">Pricing</a></li>\n      </ul>\n    </div>\n    <div class=\"footer-col\">\n      <div class=\"footer-col-head\">Resources</div>\n      <ul>\n        <li><a href=\"/resources/\">Resources</a></li>\n        <li><a href=\"/contact/\">Contact</a></li>\n        <li><a href=\"https://www.linkedin.com/company/getpacerai\" target=\"_blank\" rel=\"noopener\">LinkedIn</a></li>\n        <li><a href=\"https://app.getpacerai.com/.auth/login/aad\">Log In</a></li>\n      </ul>\n    </div>\n  </div>\n</footer>\n</div>\n",
