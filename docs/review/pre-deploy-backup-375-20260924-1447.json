(--navy)}\n#pacerai-homepage .ccard .clink svg{width:15px;height:15px;fill:#0A66C2}\n#pacerai-homepage .ccard.primary .clink{background:var(--navy);color:#fff;padding:11px 20px;border-radius:10px}\n#pacerai-homepage .ccard.primary .clink:hover{background:var(--navy-dark)}\n\n#pacerai-homepage footer{background:var(--surface);border-top:1px solid var(--line);padding:56px 32px 40px}\n#pacerai-homepage .footer-top{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px;max-width:var(--maxw);margin:0 auto}\n#pacerai-homepage .footer-brand p{font-size:13.5px;color:var(--muted);margin-top:12px;max-width:280px}\n#pacerai-homepage .footer-col-head{font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--kick);margin-bottom:14px}\n#pacerai-homepage .footer-col ul{list-style:none}\n#pacerai-homepage .footer-col li{margin-bottom:9px}\n#pacerai-homepage .footer-col a{font-size:13.5px;color:var(--muted)}\n#pacerai-homepage .footer-col a:hover{color:var(--navy)}\n\n@media(max-width:900px){\n  #pacerai-homepage nav{grid-template-columns:1fr auto;padding:0 16px}\n  #pacerai-homepage .nav-links{display:none}\n  #pacerai-homepage nav.nav-open .nav-links{display:flex;flex-direction:column;position:fixed;top:64px;left:0;right:0;background:var(--bone);border-bottom:1px solid var(--line);box-shadow:0 14px 34px rgba(15,25,45,.10);padding:10px 16px 16px;gap:0;z-index:130}\n  #pacerai-homepage nav.nav-open .nav-links li{width:100%}\n  #pacerai-homepage nav.nav-open .nav-links a{display:block;width:100%;padding:14px 6px;font-size:16px;border-bottom:1px solid var(--line);border-radius:0}\n  #pacerai-homepage nav.nav-open .mobile-menu-btn span:nth-child(1){transform:translateY(7px) rotate(45deg)}\n  #pacerai-homepage nav.nav-open .mobile-menu-btn span:nth-child(2){opacity:0}\n  #pacerai-homepage nav.nav-open .mobile-menu-btn span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}\n  #pacerai-homepage .mobile-menu-btn{display:flex}\n  #pacerai-homepage